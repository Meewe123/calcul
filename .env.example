# Build-time settings. Nothing here is secret: the app has no backend and no API keys.
# Copy to .env only if you need to override the defaults.

# Public address of the deployed site. Used for canonical and Open Graph links.
SITE_URL=https://meewe123.github.io/calcul/

# Path the site is served from: "/" locally, "/calcul/" on GitHub Pages.
BASE_PATH=/
